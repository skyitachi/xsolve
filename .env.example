# ========== 必填：API 密钥 ==========
# Anthropic API 密钥（sk-ant-...），或你代理服务的密钥
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== 可选：自定义 API 代理地址 ==========
# 默认直连 Anthropic 官方：https://api.anthropic.com
# 国内使用需要设置支持 Anthropic 协议的代理地址
# 注意：代理必须支持 Anthropic Messages API 格式（/v1/messages），SDK 不支持 OpenAI 格式
# ANTHROPIC_BASE_URL=https://your-anthropic-proxy.example.com

# ========== 重要：使用自定义代理时必须指定模型 ==========
# SDK 默认模型是 claude-sonnet-4-6，在你的代理上模型名可能不同
# 设置了 CLAUDE_MODEL 后，视觉识别也会自动复用这个模型（Claude 原生支持视觉）
# CLAUDE_MODEL=claude-sonnet-4-20250514
# 常见模型名（根据你的代理支持选择）：
#   claude-sonnet-4-20250514
#   claude-sonnet-4-6
#   claude-opus-4-20250514
#   claude-haiku-4-20250414

# ========== 可选：视觉模型（一般不需要单独设置） ==========
# 不设置时自动选择：
#   - Anthropic 官方 API → claude-sonnet-4-20250514
#   - 设置了 CLAUDE_MODEL → 复用主对话模型
# 只有在需要用非 Claude 视觉模型（如 Qwen-VL）时才单独设置
# VISION_MODEL=claude-sonnet-4-20250514

# ========== 可选：视觉子代理独立 API 配置 ==========
# 默认视觉子代理继承主对话模型的 API Key / Base URL（ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL）。
# 如果视觉模型走不同的接口（不同厂商 / 不同代理 / 不同账号），可在这里单独配置：
#   VISION_API_KEY=sk-xxx
#   VISION_BASE_URL=https://your-vision-proxy.example.com
# 单独配置后视觉调用优先使用这两个值；未设置则回退到主对话模型配置。
# 注意：若 VISION_BASE_URL 指向 OpenAI 兼容接口，需同时设置 VISION_API_FORMAT=openai。
# VISION_API_KEY=
# VISION_BASE_URL=

# ========== 可选：视觉 API 格式 ==========
# 默认 anthropic（和主 SDK 一致）。如果你的视觉接口是 OpenAI 兼容格式，设为 openai
# 此时必须同时设置 VISION_MODEL 以及视觉的 API Key/Base URL
#   （VISION_API_KEY/VISION_BASE_URL，或 OPENAI_API_KEY/OPENAI_BASE_URL）
# VISION_API_FORMAT=anthropic

# ========== 可选：服务配置 ==========
PORT=8765
# Docker 部署时默认已设为 /data/xsolve.db
# DB_PATH=/data/xsolve.db

# ========== Docker 部署专用 ==========
# Claude Code CLI 出于安全不允许 root 用户使用 bypassPermissions 模式，
# 而 Docker 容器默认以 root 运行。IS_SANDBOX=1 告知 CLI 处于隔离沙箱，
# 从而放开该限制。（Dockerfile 中已默认设置，本地 node 直跑时无需配置）
# IS_SANDBOX=1
