# xsolve 配置示例
#
# 用法：cp .env.example .env，填入真实值再启动。.env 已在 .gitignore 里，不会入库。
# 优先级：DB settings 表（管理页保存的值）> 本文件 > 代码内默认值
# 一般只需填前两节的 Key，其余留空即可。

# ========== 主对话模型 ==========
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514

# ========== 视觉子代理（题目图片 / 学生草稿识别）==========
VISION_API_KEY=
VISION_BASE_URL=https://api.siliconflow.cn
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 协议留空则按 BASE_URL 自动推断；跨域网关推断错时可强制指定 openai / anthropic
# VISION_API_FORMAT=openai
# 推理模型的 max_tokens 同时限制 reasoning_content 与正文，推理吃光额度会让正文变成空串，
# 报错是「视觉模型没有返回文本内容」。遇到就开这个开关强制关推理。
# VISION_DISABLE_REASONING=true
# VISION_TIMEOUT_MS=60000
# VISION_MAX_TOKENS=2048

# ========== LLM Judge（turn 级评分）==========
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.anthropic.com
JUDGE_MODEL=claude-sonnet-4-20250514

# ========== 服务 ==========
PORT=8765
# Docker 部署时镜像内已设为 /data/xsolve.db
# DB_PATH=/data/xsolve.db

# ========== 局域网 HTTPS / PWA ==========
# PWA（装到手机主屏 / 离线可用）依赖 Service Worker，而它只在「安全上下文」下存在 ——
# 即 https:// 或 localhost。明文 http://<局域网IP> 不是，PWA 会静默失效（不报错、没按钮）。
#
# 开法：
#   1. node backend/scripts/setup-lan-https.mjs     # 生成本地 CA + 服务器证书
#   2. 取消下面两行注释，重启服务
#   3. 在每台要访问的手机上装一次 CA（脚本会打印各平台步骤）
#   4. 访问 https://<局域网IP>:8443/  （HTTP 的 8765 照旧可用，互不影响）
#
# HTTPS_ENABLED=true
# HTTPS_PORT=8443
# 证书路径默认 <仓库>/certs/xsolve-key.pem 与 <仓库>/certs/xsolve.pem，一般不用改
# HTTPS_KEY=
# HTTPS_CERT=
# Root CA 存放目录，默认 ~/.xsolve-ca（刻意放仓库外，避免 CA 私钥误入库）
# XSOVE_CA_DIR=

# ========== 学生记忆（进阶调参，可全部留空）==========
# MASTERY_HALFLIFE_DAYS=21
# MASTERY_LEARNING_RATE=0.35
# SESSION_COMPRESS_THRESHOLD=30
# SESSION_COMPRESS_KEEP=8
# MEMORY_CONSOLIDATE_INTERVAL=6
# 草稿自动识别：每轮自动 OCR 学生手写草稿并注入上下文（关掉则退回模型按需调用）
# SCRATCH_AUTO_RECOGNIZE=true
# SCRATCH_OCR_TIMEOUT_MS=30000
# SCRATCH_OCR_RETRIES=1
# SCRATCH_OCR_MAX_CHARS=600

# ========== 用户系统（进阶调参，可全部留空）==========
# 首次启动 users 表为空时会自动创建这个账号（默认 demo / demo123，且是管理员），首登后请改密
# BOOTSTRAP_STUDENT_USERNAME=demo
# BOOTSTRAP_STUDENT_PASSWORD=demo123
# AUTH_COOKIE_NAME=xsolve_sid
# AUTH_COOKIE_SECURE=false      # 上 HTTPS 后建议改成 true
# SESSION_TTL_DAYS=30
# INVITE_TTL_DAYS=7
# ALLOW_SELF_REGISTER_STUDENT=false   # 学生默认必须凭邀请码注册
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_IP_MAX_ATTEMPTS=20
# LOGIN_WINDOW_MINUTES=15
# AUDIT_RETENTION_DAYS=90
# ALLOW_GUEST=true
# GUEST_TTL_HOURS=24
# GUEST_MAX_TURNS=15
